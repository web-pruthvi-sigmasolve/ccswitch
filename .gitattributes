# Normalise line endings so gofmt and shell scripts behave the same on every OS.
* text=auto eol=lf

*.go     text eol=lf
*.sh     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
Makefile text eol=lf

# PowerShell scripts are checked out with CRLF.
*.ps1    text eol=crlf

*.gif binary
*.png binary
